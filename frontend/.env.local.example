# Copy to .env.local and fill in.
# For local dev: http://localhost:8000
# For production: your Render/Railway/Fly.io URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Your Cal.com public booking link, e.g. https://cal.com/bhuvanesh/30min
# Shown in the "Book a Call" button. Leave blank to hide the button.
NEXT_PUBLIC_CALCOM_URL=https://cal.com/your-username/30min
