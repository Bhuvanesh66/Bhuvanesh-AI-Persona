# ──────────────────────────────────────────────────────────────────────────
#  AI Persona — environment configuration
#  Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# ---- Persona identity ----
PERSONA_NAME=Bhuvanesh
GITHUB_OWNER=Bhuvanesh66

# ---- GitHub token ────────────────────────────────────────────────────────
# ONE token does THREE things:
#   1. Reads your GitHub repos + commit history for the corpus
#   2. Calls the LLM  (gpt-4o) via GitHub Models — free
#   3. Calls embeddings (text-embedding-3-large) via GitHub Models — free
#
# Get it: github.com → Settings → Developer settings →
#         Personal access tokens → Tokens (classic) → Generate
#         Scopes needed: public_repo
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- GitHub Models (LLM + embeddings — already free via GITHUB_TOKEN) ----
# Change these if you want a different model from the GitHub marketplace.
CHAT_MODEL=gpt-4o
VOICE_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=github
EMBED_MODEL=text-embedding-3-large

# ---- Vector store (Supabase Postgres + pgvector) ────────────────────────
# supabase.com → Project Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# ---- Resume ----
RESUME_PATH=data/resume.pdf

# ---- Cal.com (optional — only needed for the booking feature) ────────────
# cal.com → Settings → Security → API Keys
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Integer from the event-type URL: /event-types/12345
CALCOM_EVENT_TYPE_ID=0
