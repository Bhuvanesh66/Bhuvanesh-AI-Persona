# ──────────────────────────────────────────────────────────────────────────────
#  AI Persona — environment configuration
#  Copy to `.env` and fill in real values. `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ---- Persona identity ----
PERSONA_NAME=Bhuvanesh
GITHUB_OWNER=Bhuvanesh66

# ---- GitHub token — corpus ingest + embeddings ONLY ─────────────────────────
# Used once during `python -m app.ingest.run` to scrape repos and embed chunks.
# NOT used for live LLM calls (Groq handles those).
# Needs "Models: Read" permission (fine-grained PAT).
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Groq — live LLM for chat + voice ───────────────────────────────────────
# Free tier: 14,400 req/day, ~100ms time-to-first-token (much faster than GitHub Models)
# Sign up: console.groq.com → API Keys → Create key
ENABLE_GROQ=false
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=llama-3.3-70b-versatile
VOICE_MODEL=llama-3.1-8b-instant


# ---- Embeddings (GitHub Models — free, used during ingest only) ----
EMBEDDING_PROVIDER=github
EMBED_MODEL=text-embedding-3-large

# ---- Vector store (Supabase Postgres + pgvector) ────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# ---- Resume ----
RESUME_PATH=data/resume.pdf

# ---- CORS (comma-separated origins, or * for open) ─────────────────────────
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# ---- Cal.com booking ────────────────────────────────────────────────────────
# cal.com → Settings → Security → API Keys
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Integer from: app.cal.com/event-types/XXXXX
CALCOM_EVENT_TYPE_ID=0
# Your cal.com public username — from cal.com/YOUR-USERNAME
CALCOM_USERNAME=your-cal-username
# Event slug — from your booking URL: cal.com/username/EVENT-SLUG
CALCOM_EVENT_SLUG=30min
