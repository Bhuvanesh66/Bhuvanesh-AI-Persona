# ──────────────────────────────────────────────────────────────────────────
#  AI Persona — environment configuration
#  Copy this file to `.env` and fill in the values. `.env` is gitignored.
#  See README.md → "How to get each key" for step-by-step instructions.
# ──────────────────────────────────────────────────────────────────────────

# ---- Persona identity ----
PERSONA_NAME=Bhuvanesh
GITHUB_OWNER=Bhuvanesh66

# ---- Anthropic (the LLM brain) ----
# Chat/RAG uses Opus 4.8; voice will use Haiku 4.5 later.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_MODEL=claude-opus-4-8
VOICE_MODEL=claude-haiku-4-5

# ---- GitHub (corpus ingestion) ----
# A classic or fine-grained PAT with public-repo read. Without it you get
# 60 req/hr (not enough for full ingest); with it, 5000 req/hr.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Embeddings ----
# EMBEDDING_PROVIDER = "voyage" (default) or "openai". Both produce 1024-dim vectors.
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=pa-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Vector store (Supabase Postgres + pgvector) ----
# Use the "Session pooler" / direct connection string from Supabase.
# Format: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres

# ---- Resume ----
# Drop your resume at this path (PDF or .txt). Defaults to data/resume.pdf
RESUME_PATH=data/resume.txt

# ---- Cal.com (scheduling — Part A voice + Part B chat) ----
# Get these after creating a Cal.com account (see README § "How to get each key").
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The integer ID of your "30-min intro call" event type (visible in the Cal.com URL).
CALCOM_EVENT_TYPE_ID=0
