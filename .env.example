# ──────────────────────────────────────────────────────────────────────────────
#  AI Persona — environment configuration
#  Copy to `.env` and fill in real values. `.env` is gitignored.
# ──────────────────────────────────────────────────────────────────────────────

# ---- Persona identity ----
PERSONA_NAME=Bhuvanesh
GITHUB_OWNER=Bhuvanesh66

# ---- GitHub token — corpus ingest + embeddings + LLM ─────────────────────────
# Used for:
#   1. Reads GitHub repos + commit history for the corpus
#   2. Calls LLM (gpt-4o-mini) via GitHub Models — free
#   3. Calls embeddings (text-embedding-3-large) via GitHub Models — free
# Get it: github.com → Settings → Developer settings →
#         Personal access tokens → Tokens (fine-grained) → Generate
#         Permissions needed: Repository access: Public repositories (read-only), Models: Read
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- GitHub Models (gpt-4o-mini for chat and voice) ───────────────────────────
# Free tier: uses GITHUB_TOKEN above
CHAT_MODEL=gpt-4o-mini
VOICE_MODEL=gpt-4o-mini


# ---- Embeddings (GitHub Models — free, used during ingest only) ----
EMBEDDING_PROVIDER=github
EMBED_MODEL=text-embedding-3-large

# ---- Vector store (Supabase Postgres + pgvector) ────────────────────────────
DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres

# ---- Resume ----
RESUME_PATH=data/resume.pdf

# ---- CORS (comma-separated origins, or * for open) ─────────────────────────
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=*

# ---- Cal.com booking ────────────────────────────────────────────────────────
# cal.com → Settings → Security → API Keys
CALCOM_API_KEY=cal_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Integer from: app.cal.com/event-types/XXXXX
CALCOM_EVENT_TYPE_ID=0
# Your cal.com public username — from cal.com/YOUR-USERNAME
CALCOM_USERNAME=your-cal-username
# Event slug — from your booking URL: cal.com/username/EVENT-SLUG
CALCOM_EVENT_SLUG=30min
